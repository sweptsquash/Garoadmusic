{
    "private": true,
    "type": "module",
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "Firefox ESR",
        "not dead"
    ],
    "scripts": {
        "dev": "run-p routes lint && vite",
        "build:dev": "run-p routes lint && vite build --mode development && vite build --mode development --ssr",
        "build:prod": "run-p routes lint tsc && vite build && vite build --ssr",
        "lint": "oxlint resources/ --type-aware --fix && oxfmt --write resources/",
        "test:lint": "oxlint resources/ --type-aware && oxfmt --check resources/",
        "routes": "php artisan trail:generate",
        "tsc": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@heroicons/vue": "^2.2.0",
        "@inertiajs/vue3": "^2.3.15",
        "@vue/server-renderer": "^3.5.28",
        "@vueuse/core": "^14.2.1",
        "dayjs": "^1.11.19",
        "lodash": "^4.17.23",
        "mini-svg-data-uri": "^1.4.4",
        "momentum-layout": "^0.1.0",
        "momentum-trail": "^0.4.0",
        "pluralize": "^8.0.0",
        "vue": "^3.5.28",
        "vue-demi": "^0.14.10"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.16",
        "@types/lodash": "^4.17.20",
        "@types/node": "^24.10.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/language-server": "^3.1.3",
        "@vue/typescript-plugin": "^3.1.3",
        "autoprefixer": "^10.4.21",
        "axios": "^1.13.5",
        "cssnano": "^7.1.2",
        "laravel-vite-plugin": "^3.1.0",
        "npm-run-all": "^4.1.5",
        "oxfmt": "^0.61.0",
        "oxlint": "^1.76.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.8.1",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "qs": ">=6.16.0",
        "sass": "^1.97.3",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.9.3",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^31.0.0",
        "vite": "^8.1.4",
        "vite-plugin-manifest-sri": "^0.2.0",
        "vite-plugin-oxlint": "^2.1.2",
        "vite-plugin-watch": "^0.3.1",
        "vue-tsc": "^3.3.3"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.59.1",
        "@rollup/rollup-win32-x64-msvc": "4.59.1",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.2.2",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.2.2",
        "lightningcss-linux-x64-gnu": "^1.32.0",
        "lightningcss-win32-x64-msvc": "^1.32.0"
    }
}
