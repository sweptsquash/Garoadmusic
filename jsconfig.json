{
    "compilerOptions": {
        "allowJs": true,
        "resolveJsonModule": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./resources/js/*"],
            "~/*": ["./node_modules/*"]
        }
    },
    "exclude": ["node_modules", "public"]
}
